{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Habits",
  "version": "2.2.4",
  "identifier": "com.bosco.habits",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Habits",
        "width": 1120,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "widget",
        "title": "Habits — Today",
        "url": "index.html?view=widget",
        "width": 300,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' data: blob: ipc: http://ipc.localhost wss://cloud.jazz.tools https://cloud.jazz.tools"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNUY4QTBFNTE0QTNGM0MKUldROFAwcFJEb3BmY01TZkpZcGhJWWZEbHZWcFpZRG1VSW5wdldNWHdaK2EwZmNvY1p4YmltRmYK",
      "endpoints": [
        "https://github.com/Bosco98/habit-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
