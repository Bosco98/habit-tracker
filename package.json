    "gsap": "^3.15.0",
    "jazz-tools": "^0.20.19",
    "lucide-react": "^1.27.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "shadcn": "^4.15.0",
